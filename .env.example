# Настройки для HydraAI (OpenAI-совместимый API)
# Для LiteLLM перед названием модели из HydraAI нужно писать openai/
HARNESS_MODEL=openai/claude-3-7-sonnet-latest
HARNESS_API_BASE=https://api.hydraai.ru/v1
HARNESS_API_KEY=

# Папка, в которой агент будет работать (точка = текущая папка)
HARNESS_WORKDIR=.
